{
  "name": "gestion-urbana-backend",
  "version": "1.0.0",
  "description": "Backend del Sistema de Gestión Urbana Inteligente con IA",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"AUTH,REPORT\" --prefix-colors \"cyan,yellow\" \"cd backend/auth-service && nodemon index.js\" \"cd backend/report-service && nodemon index.js\"",
    "dev:auth": "cd backend/auth-service && nodemon index.js",
    "dev:report": "cd backend/report-service && nodemon index.js",
    "start": "concurrently --names \"AUTH,REPORT\" \"cd backend/auth-service && node index.js\" \"cd backend/report-service && node index.js\"",
    "check:backend": "node scripts/check-backend-syntax.js",
    "verify:backend": "node scripts/check-backend-syntax.js",
    "lint": "node scripts/check-backend-syntax.js",
    "lint:fix": "node scripts/check-backend-syntax.js"
  },
  "keywords": [
    "gestion-urbana",
    "nodejs",
    "postgresql",
    "jwt",
    "api",
    "ia"
  ],
  "author": "Equipo GestionUrbana",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "argon2": "^0.44.0",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.17",
    "pg": "^8.13.1",
    "sequelize": "^6.35.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.10"
  }
}