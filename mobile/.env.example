# En emulador Android, 10.0.2.2 apunta a localhost de tu computadora.
# En teléfono físico, usa la IP local de tu computadora.
# Ejemplo teléfono físico:
# EXPO_PUBLIC_AUTH_API_URL=http://192.168.1.10:3006/gestionurbana/v1
# EXPO_PUBLIC_REPORT_API_URL=http://192.168.1.10:3007/gestionurbana/v1

EXPO_PUBLIC_AUTH_API_URL=http://10.0.2.2:3006/gestionurbana/v1
EXPO_PUBLIC_REPORT_API_URL=http://10.0.2.2:3007/gestionurbana/v1